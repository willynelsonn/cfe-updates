# No Windows, o Servidor.bat cria o .env sozinho (manage.py preparar_servidor).
# Em outro servidor, copie para .env (ou exporte no serviço) e ajuste.
FOLHA_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
FOLHA_DEBUG=false
FOLHA_ALLOWED_HOSTS=folha.seudominio.com.br
FOLHA_CSRF_TRUSTED_ORIGINS=https://folha.seudominio.com.br
# Banco PostgreSQL (recomendado em produção)
FOLHA_DB_ENGINE=postgres
FOLHA_DB_NAME=folha
FOLHA_DB_USER=folha
FOLHA_DB_PASSWORD=
FOLHA_DB_HOST=localhost
# Pasta privada onde ficam os certificados A1 (fora da pasta pública)
FOLHA_PRIVATE_MEDIA=/var/lib/folhaweb/privado
# Arquivo .pem com as ACs da ICP-Brasil, se o servidor não reconhecer o TLS do eSocial
FOLHA_ESOCIAL_CA_BUNDLE=
# Integra Contador / SERPRO (opcional, pago) — emite o DARF da DCTFWeb automaticamente
FOLHA_INTEGRA_KEY=
FOLHA_INTEGRA_SECRET=
FOLHA_INTEGRA_CONTRATANTE=
# Token do Cloudflare Tunnel para endereço fixo (vazio = endereço provisório trycloudflare.com)
FOLHA_CLOUDFLARE_TOKEN=
# Bloqueio de login: tentativas erradas e minutos de espera
FOLHA_LOGIN_TENTATIVAS=5
FOLHA_LOGIN_BLOQUEIO_MIN=15
# HSTS (segundos). Deixe 0 até confirmar que o HTTPS está funcionando sempre.
FOLHA_HSTS_SEGUNDOS=0
# Cor padrão do sistema: laranja, azul, verde, roxo, rosa ou grafite
FOLHA_COR_PADRAO=grafite
